# ---- API (apps/api) ----------------------------------------------------
# Port for the JSON API and the render endpoint.
PORT=4000

# MongoDB connection string. The default matches docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/wyxan

# Comma-separated list of origins allowed to frame the render endpoint and
# allowed to call the API. The app origin is localhost:3000 by default.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Largest author HTML accepted by the publish endpoint, in bytes.
MAX_HTML_BYTES=65536

# ---- Web (apps/web) -----------------------------------------------------
# Base URL of the API, as the browser sees it. The render endpoint is served
# from this origin, which is deliberately NOT the app origin: the split is the
# first containment layer (see SPEC 1.1).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:4000

# Origin of the app itself, used by the web app to frame the render endpoint.
WEB_ORIGIN=http://localhost:3000
